/* haystack-tag on upstream promicro_nrf52840 (nRF52840 ProMicro / nice!nano v2
 * footprint, Tenstar red clone compatible).
 *
 * Upstream board default is LDO + XTAL LFCLK. Clones may lack the 32.768 kHz
 * crystal, so LFCLK=RC is selected in the matching .conf; DCDC (normal
 * voltage) is enabled here via devicetree (Zephyr >= 4: Kconfig
 * SOC_DCDC_NRF52X is deprecated).
 */

/* DCDC normal voltage: LDO ~10mA adv peaks -> ~5mA */
&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};
