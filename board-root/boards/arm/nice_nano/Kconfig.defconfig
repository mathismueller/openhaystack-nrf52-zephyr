# Vendored from ZMK (commit c06fa48^). Fixed `config BOARD` default:
# upstream ZMK hardcodes "nice_nano" for both variants; here each board
# reports its own name.

if BOARD_NICE_NANO || BOARD_NICE_NANO_V2

config BOARD
    default "nice_nano" if BOARD_NICE_NANO
    default "nice_nano_v2" if BOARD_NICE_NANO_V2

if USB_DEVICE_STACK

config USB_NRFX
    default y

endif # USB_DEVICE_STACK

config BT_CTLR
    default BT

endif # BOARD_NICE_NANO || BOARD_NICE_NANO_V2
